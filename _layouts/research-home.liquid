<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ site.title | escape }}</title>
    <meta name="description" content="{{ site.description | strip | escape }}">
    <meta name="author" content="{{ site.title | escape }}">
    <meta name="theme-color" content="#f6f7fb">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ site.title | escape }}">
    <meta property="og:description" content="{{ site.description | strip | escape }}">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ '/assets/img/prof_pic.jpg' | absolute_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/assets/css/research-home.css' | relative_url }}">
    <script src="{{ '/assets/js/research-home.js' | relative_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#home">Skip to content</a>
    <canvas id="life-background" aria-hidden="true"></canvas>
    <header class="site-header">
      <nav class="navigation" aria-label="Main navigation">
        <a class="brand" href="#home">Amir Kooshan</a>
        <ul class="nav-links">
          <li><a href="#home" aria-current="location">Home</a></li>
          <li><a href="#news">News</a></li>
          <li><a href="#research">Research</a></li>
          <li><a href="#projects">Projects</a></li>
          <li><a href="{{ '/cv/' | relative_url }}">CV</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <section class="introduction" id="home" aria-labelledby="name" tabindex="-1">
        <figure class="portrait panel">
          <img src="{{ '/assets/img/prof_pic.jpg' | relative_url }}" alt="Amir Kooshan Fattah Hesari" width="224" height="224" fetchpriority="high">
          <figcaption>
            Sharif University of Technology<br>
            Tehran, Iran
          </figcaption>
        </figure>
        <div class="bio panel">
          <h1 id="name">
            Amir Kooshan<br>
            Fattah Hesari
          </h1>
          <div class="biography">{{ content }}</div>
          <div class="contact-links" aria-label="Contact and profiles">
            <a href="{{ site.data.socials.cv_pdf | relative_url }}">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8M8 17h6"/>
              </svg>
              <span>CV <span class="link-note">(PDF)</span></span>
            </a>
            <a href="https://github.com/{{ site.data.socials.github_username }}">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7M15 22v-3.4a3 3 0 0 0-.8-2.3c2.7-.3 5.5-1.3 5.5-6a4.7 4.7 0 0 0-1.3-3.3 4.3 4.3 0 0 0-.1-3.3s-1-.3-3.5 1.3a12 12 0 0 0-6.4 0C6 3.4 5 3.7 5 3.7A4.3 4.3 0 0 0 4.9 7a4.7 4.7 0 0 0-1.3 3.3c0 4.7 2.8 5.7 5.5 6a3 3 0 0 0-.8 2.3V22"/>
              </svg>
              <span>GitHub</span>
            </a>
            <a href="mailto:{{ site.data.socials.email }}">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/>
              </svg>
              <span>{{ site.data.socials.email }}</span>
            </a>
          </div>
        </div>
      </section>

      <section class="content-section panel" id="news" aria-labelledby="news-heading">
        <h2 id="news-heading">News</h2>
        <ul class="news-list">
          {% assign news_items = site.news | sort: 'date' | reverse %}
          {% for item in news_items limit: 5 %}
            <li>
              <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b. %Y' }}</time>
              <div>{{ item.content | markdownify }}</div>
            </li>
          {% endfor %}
        </ul>
      </section>

      <section class="content-section panel" id="research" aria-labelledby="research-heading">
        <h2 id="research-heading">Research</h2>
        <article class="entry">
          <h3>Fast adaptation in changing environments</h3>
          <div class="topics" aria-label="Research topics">
            <span class="topic purple">Meta-Reinforcement Learning</span>
            <span class="topic green">Continual Learning</span>
          </div>
          <p>
            Research with Dr. Soleymani Baghshah at Sharif’s MLL Lab on meta-reinforcement learning methods that adapt to non-stationary dynamics from
            limited recent experience.
          </p>
          <p class="entry-meta">Sharif University of Technology · January 2026–present</p>
        </article>
        <article class="entry">
          <h3>Transfer learning for EEG anomaly detection</h3>
          <div class="topics" aria-label="Research topics">
            <span class="topic blue">Signal Processing</span>
            <span class="topic pink">Transfer Learning</span>
          </div>
          <p>
            Worked with Dr. Qiuqiang Kong at the <a href="http://dsp.ee.cuhk.edu.hk/">CUHK DSP Lab</a> on using Pre-trained Audio Neural Networks for
            EEG anomaly detection.
          </p>
          <p class="entry-meta">The Chinese University of Hong Kong · Research internship, 2025</p>
        </article>
      </section>

      <section class="content-section panel" id="projects" aria-labelledby="projects-heading">
        <h2 id="projects-heading">Selected Projects</h2>
        {% assign projects = site.projects | sort: 'importance' %}
        {% for project in projects %}
          <article class="entry">
            <div class="entry-header">
              <h3>
                <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
              </h3>
              <div class="project-links">
                {% if project.github -%}
                  <a href="{{ project.github }}" aria-label="{{ project.title | escape }} on GitHub">[GitHub]</a>
                {%- endif %}
                <a href="{{ project.url | relative_url }}" aria-label="Read about {{ project.title | escape }}">[Details]</a>
              </div>
            </div>
            <p>{{ project.description }}</p>
          </article>
        {% endfor %}
        <a class="more-link" href="{{ '/projects/' | relative_url }}">All projects <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <footer class="site-footer">
      <p>
        © {{ site.time | date: '%Y' }}
        {{ site.title }}.
      </p>
      <p>
        Design inspired by <a href="https://btx0424.github.io/">Botian Xu</a> ·
        <a href="https://github.com/{{ site.data.socials.github_username }}/Akooshan82.github.io">Source</a>
      </p>
      <button class="motion-toggle" type="button" aria-pressed="false" hidden>Pause background</button>
    </footer>
  </body>
</html>
